# WhatsApp comercial da Invictus — somente dígitos, com DDI + DDD
NEXT_PUBLIC_WHATSAPP=559885555608

# Domínio de produção — usado em metadata, Open Graph, sitemap e compartilhamento.
# Tem que ser exatamente o domínio real (imobiliariainvictus.com.br, não invictusimoveis.com.br
# — são domínios diferentes) ou o og:image do WhatsApp/Instagram aponta pro lugar errado.
NEXT_PUBLIC_SITE_URL=https://www.imobiliariainvictus.com.br

# URL do backend FastAPI (server-side only — usado pelas rotas /api/* e pelas páginas do admin)
BACKEND_API_URL=http://localhost:8000

# Mesma URL do backend, mas pública — usada pelo upload de foto/PDF/vídeo no admin,
# que manda o arquivo direto do navegador pro backend, sem passar pelo proxy do
# Next.js (a Vercel limita bem o tamanho do corpo das suas próprias functions).
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Mesmo valor de JWT_SECRET do backend — usado pelo middleware para validar o token do admin
JWT_SECRET=troque-por-uma-chave-aleatoria-longa
