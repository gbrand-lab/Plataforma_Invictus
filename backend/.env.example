DATABASE_URL=postgresql://user:password@localhost:5432/invictus
JWT_SECRET=troque-por-uma-chave-aleatoria-longa
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000

# Fotos de imóveis (upload de imagem e páginas extraídas de PDF).
# Sem essas 3 variáveis preenchidas, o upload cai no disco local (uploads/) —
# ok em dev, mas em produção (Railway) o disco não persiste entre deploys.
# Pegue os valores em https://cloudinary.com/console (plano free já serve).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Aviso automático por e-mail pros leads cadastrados, disparado quando um
# imóvel novo é publicado (ver app/email.py). Sem essas variáveis, o envio
# é pulado silenciosamente — o cadastro de imóvel continua funcionando normal.
# Pegue a API key em https://resend.com/api-keys (plano free já serve).
# RESEND_REMETENTE_EMAIL precisa ser de um domínio verificado no Resend.
RESEND_API_KEY=
RESEND_REMETENTE_EMAIL=
RESEND_REMETENTE_NOME=Invictus Imóveis
FRONTEND_BASE_URL=https://invictusimoveis.com.br
