{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "invictus-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "invictus-plataforma", "run", "dev"],
      "port": 3000
    },
    {
      "name": "invictus-backend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "cd /d backend && python -m uvicorn app.main:app --reload --port 8001"],
      "port": 8001
    }
  ]
}
